# ==============================================================================
# NAMUSTE VOICE/CHAT AI MODULE — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in real values before running.
# NOTE: DO NOT commit real API keys to git.
# ==============================================================================

# OpenAI API Key (Required)
# Used for conversational intelligence, intent understanding, and structured CRM
# extraction (gpt-4o-mini). Also serves as fallback for Whisper speech-to-text
# if Sarvam is unavailable.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Sarvam AI API Subscription Key (Required)
# Used for low-latency Indian speech-to-text (saaras:v3) and natural voice
# synthesis (bulbul:v3).
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API Key (Optional Fallback)
# Automatic zero-downtime failover if OpenAI encounters rate limits or hiccups.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Appointment / Lead Webhook URL (Optional)
# Dispatches consultation booking details (patient name, phone, doctor/
# department, slot) to your WhatsApp gateway, CRM, or Make.com/Zapier webhook.
AI_DEMO_WEBHOOK_URL=https://your-webhook-endpoint.com/api/leads
