# ==============================================================================
# NAMUSTE VOICE/CHAT AI MODULE — ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in real values before running.
# NOTE: DO NOT commit real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI & SPEECH PROVIDERS (REQUIRED)
# ------------------------------------------------------------------------------

# OpenAI API Key (Required)
# Used for conversational intelligence, intent understanding, and structured CRM extraction (gpt-4o-mini).
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Sarvam AI API Subscription Key (Required)
# Used for low-latency Indian vernacular speech-to-text (saaras:v3) and natural voice synthesis (bulbul:v3).
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Gemini API Key (Optional Fallback)
# Automatic zero-downtime failover if OpenAI encounters rate limits or hiccups.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. PLIVO TELEPHONY INTEGRATION (REQUIRED FOR REAL PHONE CALLS)
# ------------------------------------------------------------------------------

# Plivo Auth ID & Auth Token (Found in Plivo Console Dashboard: https://console.plivo.com/dashboard/)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here

# Plivo Sender Phone Number (The phone number you purchased on Plivo, in E.164 format, e.g. +14151234567 or +91...)
PLIVO_PHONE_NUMBER=your_plivo_phone_number_here

# Public App Base URL (Used by Plivo to fetch XML callbacks & stream TTS audio)
# For local testing, use your ngrok/localtunnel URL. For Vercel production:
NEXT_PUBLIC_APP_URL=https://namsute-voice-ai-module.vercel.app

# ------------------------------------------------------------------------------
# 3. CRM & WEBHOOK DISPATCH (OPTIONAL)
# ------------------------------------------------------------------------------

# General Appointment / Lead Webhook URL (Clinic bookings & general leads)
AI_DEMO_WEBHOOK_URL=https://your-webhook-endpoint.com/api/leads

# Dedicated Automobile Webhook URL (Service appointments & test drive bookings)
AUTOMOBILE_WEBHOOK_URL=https://your-webhook-endpoint.com/api/automobile-leads
